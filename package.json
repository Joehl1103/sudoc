{
  "name": "sudoc",
  "displayName": "Sudoc",
  "description": "Structured workflows with explicit interpretation boundaries and verified execution.",
  "version": "0.0.1",
  "publisher": "local-experiments",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test language.test.js cli.test.js skill.test.js sudoc*.test.js",
    "test:nvim": "nvim --headless -u NONE -i NONE -l nvim/test.lua",
    "lint": "node cli.js lint",
    "format": "node cli.js format",
    "editor": "node open-editor.js"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sudoc",
        "aliases": [
          "Sudoc",
          "Workflow Experiment"
        ],
        "extensions": [
          ".sudoc",
          ".workflow"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sudoc",
        "scopeName": "source.sudoc",
        "path": "./workflow.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sudoc]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.defaultFormatter": "local-experiments.sudoc"
      }
    }
  }
}
