{
  "scopeName": "source.workflow-experiment",
  "patterns": [
    {
      "name": "comment.line.number-sign.workflow",
      "match": "^\\s*#.*$"
    },
    {
      "name": "keyword.control.workflow",
      "match": "(?i)^\\s*(FOR\\s+EACH|CONTRACT|INPUT|OUTPUT|CONDITION|DECIDE|WHEN|WITH|PRODUCES|PROVIDE|ON|EXIT|DEFINE|USING|WHERE|DO|THEN|IF|ELSE|NOTE|STOP)(?=\\s|:|$)"
    },
    {
      "name": "entity.name.function.workflow",
      "match": "(?<![A-Za-z0-9._%+-])@[A-Z][A-Z0-9_]*"
    },
    {
      "name": "variable.other.workflow",
      "match": "\\$[A-Z][A-Z0-9_]*"
    },
    {
      "name": "markup.underline.link.workflow",
      "match": "https?://[^\\s]+"
    },
    {
      "name": "string.quoted.double.workflow",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.workflow"
        }
      ]
    },
    {
      "name": "keyword.operator.workflow",
      "match": "===|==|!=|<=|>=|[<>]|(?i:\\b(?:AND|OR|NOT|IN|AS|FROM)\\b)"
    },
    {
      "name": "constant.language.workflow",
      "match": "(?i:\\b(?:true|false|unknown|success|failure|review)\\b)"
    }
  ]
}
