{
  "scopeName": "source.sudoc",
  "patterns": [
    {
      "name": "comment.line.number-sign.sudoc",
      "match": "^\\s*#.*$"
    },
    {
      "name": "keyword.control.sudoc",
      "match": "(?i)^\\s*(FOR\\s+EACH|DEFINE|USING|WHERE|DO|THEN|IF|ELSE|NOTE|STOP|VERSION|INPUT|OUTPUT|RUN|WITH|CHECK|INTERPRET|QUESTION|LIMIT|EVIDENCE|ACCEPT|JEV|CONFIDENCE|ON|UNKNOWN|REVIEW|REJECT|FAILURE|PROVIDE|AS)(?=\\s|:|$)"
    },
    {
      "name": "entity.name.function.sudoc",
      "match": "(?<![A-Za-z0-9._%+-])@[A-Z][A-Z0-9_]*"
    },
    {
      "name": "variable.other.sudoc",
      "match": "\\$[A-Za-z][A-Za-z0-9_.]*"
    },
    {
      "name": "markup.underline.link.sudoc",
      "match": "https?://[^\\s]+"
    },
    {
      "name": "string.quoted.double.sudoc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.workflow"
        }
      ]
    },
    {
      "name": "keyword.operator.sudoc",
      "match": "===|==|!=|(?i:\\b(?:AND|OR|NOT|IN)\\b)"
    }
  ]
}
